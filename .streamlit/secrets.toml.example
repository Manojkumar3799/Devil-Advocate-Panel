# Streamlit Secrets configuration example for Devil's Advocate Panel
# On Streamlit Community Cloud, paste these keys into App Settings -> Secrets.
# For local development, copy to .streamlit/secrets.toml or use .env.

APP_BASE_URL = "http://localhost:8501"

# LLM Providers
XAI_API_KEY = "xai-..."
GOOGLE_API_KEY = "AIzaSy..."
GROQ_API_KEY = "gsk_..."
TAVILY_API_KEY = "tvly-..."

# Supabase Configuration
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "eyJhbGciOi..."
SUPABASE_SERVICE_KEY = "eyJhbGciOi..."

# OAuth Connectors
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""

STRIPE_CLIENT_ID = ""
STRIPE_CLIENT_SECRET = ""

GOOGLE_OAUTH_CLIENT_ID = ""
